+    expect(row?.source_data_at).toBeInstanceOf(Date); expect(row?.snapshot_stored_at).toBeInstanceOf(Date)
+    expect(await getRoleCapabilityDisplaySnapshot('ai-pdm',database)).toEqual(actual)
