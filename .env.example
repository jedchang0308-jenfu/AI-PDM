# Local MVP defaults
PDM_DB_PROVIDER=sqlite
# Operational target: cloud_sql_postgres. It connects only to the local Cloud SQL Auth Proxy sidecar.
PDM_CLOUD_SQL_INSTANCE_CONNECTION_NAME=
PDM_CLOUD_SQL_HOST=127.0.0.1
PDM_CLOUD_SQL_PORT=5432
PDM_CLOUD_SQL_DATABASE=ai_pdm
PDM_CLOUD_SQL_USER=
PDM_CLOUD_SQL_POOL_MAX=5
PDM_CLOUD_SQL_CONNECTION_TIMEOUT_MS=10000
PDM_CLOUD_SQL_IDLE_TIMEOUT_MS=600000
PDM_CLOUD_SQL_STATEMENT_TIMEOUT_MS=30000
PDM_CLOUD_SQL_QUERY_TIMEOUT_MS=35000
PDM_CLOUD_SQL_MAX_CONNECTIONS=100
# Static passwords are prohibited for cloud_sql_postgres. Authentication is supplied by the localhost proxy sidecar.
PDM_POSTGRES_URL=
PDM_POSTGRES_ADMIN_URL=
PDM_POSTGRES_POOLER_MODE=direct
PDM_POSTGRES_MAX_CONNECTIONS=5
PDM_SUPABASE_TARGET_NAME=
# Empty keeps normal local development behavior. Set to official-numbering-draft only during the approved narrow slice process.
PDM_PRODUCTION_SLICE_MODE=
PDM_POSTGRES_SHADOW_URL=
PDM_SHADOW_SQLITE_PATH=
# Live smoke approval is intentionally not stored here.
# Set PDM_RUNTIME_SMOKE_APPROVED=true only for an explicitly approved command.
PDM_DATA_DIR=./data
PDM_REPOSITORY_DIR=./data/repository
PDM_MAX_UPLOAD_FILE_BYTES=52428800
PDM_STORAGE_LARGE_FILE_THRESHOLD_MB=500
PDM_STORAGE_PROVIDER=local_repository
# Phase 1 pointer/fail-closed target only. Live direct-GCS I/O is not available before DEV-046 Phase 3B.
PDM_GCS_PROJECT_ID=
PDM_GCS_BUCKET=
PDM_GCS_RELEASE_PACKAGE_BUCKET=
PDM_SUPABASE_URL=
PDM_SUPABASE_SERVICE_ROLE_KEY=
PDM_SUPABASE_STORAGE_BUCKET=pdm-hot
PDM_SUPABASE_RELEASE_PACKAGE_BUCKET=pdm-release
PDM_SUPABASE_SIGNED_URL_TTL_SECONDS=300
PDM_SUPABASE_SIGNED_URL_MAX_TTL_SECONDS=3600
# Keep disabled until staging QC explicitly approves live object IO.
PDM_SUPABASE_STORAGE_LIVE_ENABLED=0
PDM_BACKUP_DIR=./data/backups
PDM_BACKUP_EXTRA_PATHS=
PDM_QUALITY_DIR=./data/quality
PDM_EVIDENCE_DIR=./data
PDM_REPORT_DIR=./data
PDM_RESTORE_DRILL_DIR=./data/restore-drills
PDM_RESTORE_TARGET_DIR=./data/restore-targets
PDM_RETENTION_DRILL_DIR=./data/retention-drills
PDM_RESTORE_HANDOFF_DIR=./data/restore-handoffs
PDM_FIELD_TEST_HANDOFF_DIR=./data/field-test-handoffs

# Optional native preview worker integration.
# Set on the PDM server process and pass the same value to the trusted Windows worker.
PDM_PREVIEW_WORKER_TOKEN=
PDM_PREVIEW_WORKER_BASE_URL=http://127.0.0.1:3000
PDM_SOLIDWORKS_DOCUMENT_MANAGER_KEY=
PDM_SW_DOCUMENT_MANAGER_LICENSE_KEY=
PDM_SOLIDWORKS_INTEROP_DIR=
PDM_CSC_PATH=

# Auth mode:
# - demo: local development only; seeds engineer@example.com and manager@example.com.
# - managed: production-style local auth; only users from PDM_BOOTSTRAP_USERS can login.
PDM_AUTH_MODE=demo
# Optional explicit override; HTTPS PDM_PUBLIC_BASE_URL enables Secure cookies automatically.
PDM_COOKIE_SECURE=
# Google OAuth is an explicit rollout switch. Users must first bind Google through an Admin invitation.
PDM_GOOGLE_OAUTH_ENABLED=false
PDM_GOOGLE_OAUTH_CLIENT_ID=
PDM_GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match a Google Cloud OAuth Web client redirect URI. Defaults to PDM_PUBLIC_BASE_URL + this callback path.
PDM_GOOGLE_OAUTH_REDIRECT_URI=
# Firebase BFF / Google Workspace access.
# PDM_TRUST_GOOGLE_WORKSPACE_MFA requires Workspace admin-side 2-Step Verification enforcement.
# PDM_ALLOW_GOOGLE_WORKSPACE_AAL1_PRIVILEGED is a temporary internal-pilot exception only.
PDM_TRUST_GOOGLE_WORKSPACE_MFA=false
PDM_ALLOW_GOOGLE_WORKSPACE_AAL1_PRIVILEGED=false
PDM_GOOGLE_WORKSPACE_DOMAINS=jenfu.com.tw
# Canonical public origin used to generate account invitation links, for example https://pdm.example.com.
PDM_PUBLIC_BASE_URL=
# JSON array. Required when PDM_AUTH_MODE=managed.
# Example:
# PDM_BOOTSTRAP_USERS=[{"id":"user-admin","displayName":"Admin","email":"admin@company.com","password":"change-me","role":"Admin"}]
PDM_BOOTSTRAP_USERS=

# Release mode:
# - local_stub: local development only; approve can use a local-dev stub when no release integration exists.
# - strict: production-safe; approve fails unless RELEASE_FUNCTION_URL or GOOGLE_DRIVE_RELEASED_FOLDER_ID is configured.
# - auto: allows local-dev stub outside NODE_ENV=production only.
PDM_RELEASE_MODE=local_stub

# Optional release integration.
RELEASE_FUNCTION_URL=
RELEASE_FUNCTION_TOKEN=

# Optional LLM integration. If empty, chat uses local deterministic PDM helper.
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_CONTEXT_CHARS=12000
OPENAI_CACHE_TTL_MS=300000
OPENAI_RATE_LIMIT_PER_MINUTE=20
PDM_AI_USAGE_DIR=./data/usage
PDM_AI_USAGE_LOG=on

# Optional Google Drive integration
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/sa-key.json
# Fallback Drive folder IDs (prefer configuring via Web UI System Settings)
GOOGLE_DRIVE_PENDING_FOLDER_ID=
GOOGLE_DRIVE_RELEASED_FOLDER_ID=
GOOGLE_DRIVE_MASTER_ATTACHMENTS_FOLDER_ID=
