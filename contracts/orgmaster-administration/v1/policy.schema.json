{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "orgmaster.administration-policy.v1"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "initializedByCommandId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "principalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "employeeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "roleCode": {
            "type": "string",
            "enum": [
              "platform_super_admin",
              "application_system_admin"
            ]
          },
          "applicationId": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "orgmaster",
                  "ai-pdm",
                  "financial-management-system"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "subjectKind": {
            "type": "string",
            "const": "principal"
          },
          "basis": {
            "type": "string",
            "const": "manual"
          },
          "scope": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "platform",
                  "global"
                ]
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "revoked"
            ]
          },
          "validFrom": {
            "type": "string"
          },
          "validTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdBy": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "principal",
                  "owner_workload"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string"
          },
          "catalogBinding": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "catalogVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "contentSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "stableRoleId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "roleDefinitionHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "catalogVersion",
                  "contentSha256",
                  "stableRoleId",
                  "roleDefinitionHash"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "principalId",
          "employeeId",
          "roleCode",
          "applicationId",
          "subjectKind",
          "basis",
          "scope",
          "status",
          "validFrom",
          "validTo",
          "createdBy",
          "reason",
          "catalogBinding"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contractVersion",
    "version",
    "initializedByCommandId",
    "grants"
  ],
  "additionalProperties": false
}
