{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jenfu://platform/governance-availability/v2/ai-pdm-role-capability-workspace",
  "type": "object",
  "required": ["contractVersion", "applicationId", "catalogVersion", "catalogPayloadHash", "governanceRevision", "organizationVersionId", "organizationRevision", "projectionCursor", "selectedRoleId", "roles", "dataState", "mutationAllowed", "sourceDataAt", "snapshotStoredAt", "dependency", "managementSurface"],
  "properties": {
    "contractVersion": { "const": "ai-pdm.role-capability-workspace.v3" },
    "applicationId": { "const": "ai-pdm" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "catalogPayloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "governanceRevision": { "type": "string", "minLength": 1 },
    "organizationVersionId": { "type": "string", "minLength": 1 },
    "organizationRevision": { "type": "string", "minLength": 1 },
    "projectionCursor": { "type": "integer", "minimum": 0 },
    "selectedRoleId": { "type": ["string", "null"] },
    "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/roleWorkspace" } },
    "dataState": { "enum": ["current", "stale_snapshot", "unavailable"] },
    "mutationAllowed": { "const": false },
    "sourceDataAt": { "type": "string", "format": "date-time" },
    "snapshotStoredAt": { "type": ["string", "null"], "format": "date-time" },
    "dependency": { "$ref": "#/$defs/dependency" },
    "managementSurface": { "$ref": "#/$defs/managementSurface" }
  },
  "$defs": {
    "systemAdminRole": {
      "type": "object",
      "required": ["stableRoleId", "roleCode", "displayName", "status", "assignable", "riskLevel", "subjectKind", "assignmentTier", "recommendationAllowed", "delegationAllowed", "allowedScopeKinds"],
      "properties": {
        "stableRoleId": { "const": "role-system-admin" },
        "roleCode": { "const": "system_admin" },
        "displayName": { "type": "string", "minLength": 1 },
        "status": { "const": "active" },
        "assignable": { "const": true },
        "riskLevel": { "const": "critical" },
        "subjectKind": { "const": "principal" },
        "assignmentTier": { "const": "cross_app_override" },
        "recommendationAllowed": { "const": false },
        "delegationAllowed": { "const": false },
        "allowedScopeKinds": { "const": ["global"] }
      },
      "additionalProperties": false
    },
    "manualAssignment": {
      "type": "object",
      "required": ["assignmentId", "employeeId", "principalAdmissionId", "principalHint", "status", "validFrom", "validTo", "auditReference"],
      "properties": {
        "assignmentId": { "type": "string", "minLength": 1 },
        "employeeId": { "type": "string", "minLength": 1 },
        "principalAdmissionId": { "type": "string", "minLength": 1 },
        "principalHint": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "revoked"] },
        "validFrom": { "type": "string", "format": "date-time" },
        "validTo": { "type": ["string", "null"], "format": "date-time" },
        "auditReference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "roleWorkspace": {
      "type": "object",
      "required": ["catalogRole", "effectiveHolderCount", "holderCountLabel", "managementKind", "manualAssignments"],
      "properties": {
        "catalogRole": { "$ref": "#/$defs/systemAdminRole" },
        "effectiveHolderCount": { "type": "integer", "minimum": 0 },
        "holderCountLabel": { "type": "string", "minLength": 1 },
        "managementKind": { "const": "privileged_principal" },
        "manualAssignments": { "type": "array", "items": { "$ref": "#/$defs/manualAssignment" } }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["status", "decisionCode", "correlationId"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "decisionCode": { "type": "string", "minLength": 1 },
        "correlationId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "managementSurface": {
      "type": "object",
      "required": ["label", "href"],
      "properties": {
        "label": { "const": "前往 OrgMaster 角色指派" },
        "href": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
