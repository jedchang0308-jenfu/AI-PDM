    "catalogVersion": { "type": "string", "minLength": 1 },
    "catalogPayloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "governanceRevision": { "type": "string" },
    "organizationVersionId": { "type": "string" },
    "organizationRevision": { "type": "string" },
    "projectionCursor": { "type": "integer", "minimum": 0 },
    "roles": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": true
}
