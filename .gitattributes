# Keep migration sources and generated mirrors byte-stable across Windows and CI.
db/postgres/*.sql text eol=lf
supabase/migrations/*.sql text eol=lf
supabase/migrations/manifest.json text eol=lf

# Historical local QA evidence is repository history, not production build input.
/output export-ignore

# Exact historical drafts are data, never release inputs.
.ai-doc/qa/evidence/DEV121-WORKSPACE-SAVE-20261006/*.original.txt -text whitespace=cr-at-eol
.ai-doc/qa/evidence/DEV121-WORKSPACE-SAVE-20261006/*.patch -text -diff

# Native release IAM guards compare checkout bytes with the frozen Git blobs.
/infra/google-cloud/dev-122-openswx-release-readback/*.tf text eol=lf
/infra/google-cloud/dev-122-openswx-release-readback/README.md text eol=lf
/.ai-doc/qa/DEV-122-B35-secret-version-iam-human-approval-2026-10-10.json text eol=lf
/scripts/lib/dev122-openswx-secret-version-iam.mjs text eol=lf
/scripts/dev122-openswx-secret-version-iam.mjs text eol=lf

# Byte-identical copy of the OrgMaster DEV-058 manager contract.
config/access-control/orgmaster-role-policy-manager-v1.manifest.json text eol=lf

# Keep local sandbox contract and migration source hashes stable on Windows.
contracts/local-principal-sandbox/** text eol=lf
# Preserve the exact bytes of the already-applied local ACL migration.
db/postgres/093_dev126_local_workbench_authority_acl.sql text eol=lf whitespace=blank-at-eol,space-before-tab,cr-at-eol
