<Window x:Class="AiPdmAddin.Views.SubmissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI PDM - 圖面與檔案送審平台" Height="680" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        BorderBrush="#313244"
        BorderThickness="1"
        Foreground="#CDD6F4"
        FontSize="13">
    
    <Window.Resources>
        <!-- Reusable styles for modern components -->
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ReadOnlyBox" TargetType="TextBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#BAC2DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="CaretBrush" Value="#F5E0DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#89B4FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#A6E3A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#7F849C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Metadata Panel -->
            <RowDefinition Height="140"/> <!-- File Checklist -->
            <RowDefinition Height="*"/>    <!-- Change Description -->
            <RowDefinition Height="Auto"/> <!-- Options and Auth Info -->
            <RowDefinition Height="Auto"/> <!-- Error / Progress -->
            <RowDefinition Height="Auto"/> <!-- Action Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PDM 檔案提交表單" FontSize="18" FontWeight="Bold" Foreground="#89B4FA"/>
                <TextBlock Text="自動檢核 SolidWorks 文件屬性，背景轉換工程圖" FontSize="12" Foreground="#A6ADC8" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="連線帳戶：" VerticalAlignment="Center" Foreground="#BAC2DE"/>
                <TextBlock x:Name="LblUserName" Text="使用者名稱" FontWeight="Bold" VerticalAlignment="Center" Foreground="#A6E3A1"/>
                <Button x:Name="BtnLogout" Content="登出" Margin="10,0,0,0" Padding="8,4" Style="{StaticResource SecondaryButton}" Click="BtnLogout_Click"/>
            </StackPanel>
        </Grid>

        <!-- 2. Metadata Grid -->
        <Border Grid.Row="1" Background="#11111B" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Col 1 -->
                <StackPanel Margin="0,0,8,10">
                    <TextBlock Text="圖號 (Drawing No.)" Style="{StaticResource ModernLabel}"/>
                    <TextBox x:Name="TxtDrawingNumber" Style="{StaticResource ReadOnlyBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,4,10">
                    <TextBlock Text="料號 (Part No.)" Style="{StaticResource ModernLabel}"/>
                    <TextBox x:Name="TxtPartNumber" Style="{StaticResource ReadOnlyBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0,0,10">
                    <TextBlock Text="版次 (Revision)" Style="{StaticResource ModernLabel}"/>
                    <TextBox x:Name="TxtRevision" Style="{StaticResource ReadOnlyBox}"/>
                </StackPanel>

                <!-- Row 2 -->
                <StackPanel Grid.Row="1" Margin="0,0,8,0">
                    <TextBlock Text="品名 (Part Name)" Style="{StaticResource ModernLabel}"/>
                    <TextBox x:Name="TxtPartName" Style="{StaticResource ReadOnlyBox}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,4,0">
                    <TextBlock Text="材質 (Material)" Style="{StaticResource ModernLabel}"/>
                    <TextBox x:Name="TxtMaterial" Style="{StaticResource ReadOnlyBox}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock Text="表面處理 (Finish)" Style="{StaticResource ModernLabel}"/>
                    <TextBox x:Name="TxtSurfaceFinish" Style="{StaticResource ReadOnlyBox}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. File Checklist Panel -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="即將上傳的檔案清單：" Style="{StaticResource ModernLabel}"/>
            <Border Grid.Row="1" Background="#11111B" CornerRadius="8" BorderBrush="#313244" BorderThickness="1">
                <ScrollViewer Margin="8">
                    <ItemsControl x:Name="FilesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="True" IsEnabled="False" Margin="0,4" Foreground="#CDD6F4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="[" FontWeight="Bold" Foreground="#89B4FA"/>
                                        <TextBlock Text="{Binding FileRole}" FontWeight="Bold" Foreground="#89B4FA" Width="55"/>
                                        <TextBlock Text="] " FontWeight="Bold" Foreground="#89B4FA"/>
                                        <TextBlock Text="{Binding OriginalFilename}" Foreground="#E6E9EF"/>
                                        <TextBlock Text=" (自動匯出項目)" Foreground="#A6E3A1" FontSize="11" Margin="8,0,0,0" Visibility="{Binding IsTemporary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Change Description -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="工程變更原因與說明 (Change Reason) *" Style="{StaticResource ModernLabel}"/>
            
            <TextBox x:Name="TxtChangeDescription" Grid.Row="1" Style="{StaticResource ModernTextBox}" 
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     TextChanged="TxtChangeDescription_TextChanged"/>
            
            <!-- Real-time word count & verification alert -->
            <Grid Grid.Row="2" Margin="0,5,0,0">
                <TextBlock x:Name="LblValidationAlert" Text="變更原因必須介於 5 到 100 字，不可為純數字、無意義詞彙 (如: 修改、更新)。" 
                           Foreground="#F9E2AF" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblWordCount" Text="0 / 100 字" Foreground="#BAC2DE" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- 5. Advanced settings (Reviewer count, PDM Server address) -->
        <Border Grid.Row="4" Background="#11111B" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Server URL Address -->
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="PDM 本地伺服器主機網址" Style="{StaticResource ModernLabel}"/>
                    <TextBox x:Name="TxtServerUrl" Style="{StaticResource ModernTextBox}" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Reviewer flow options -->
                <StackPanel Grid.Column="1" Width="140">
                    <TextBlock Text="簽審層級" Style="{StaticResource ModernLabel}"/>
                    <ComboBox x:Name="CmbApprovalRequired" Height="32" SelectedIndex="0" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A">
                        <ComboBoxItem Content="單級審核 (1位主管)" Tag="1"/>
                        <ComboBoxItem Content="雙重簽核 (2位主管)" Tag="2"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 6. Error & Loader Overlay -->
        <StackPanel Grid.Row="5" Margin="0,0,0,15">
            <TextBlock x:Name="LblError" Text="" Foreground="#F38BA8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,5" Visibility="Collapsed" HorizontalAlignment="Center"/>
            <ProgressBar x:Name="ProgressIndicator" Height="6" Background="#313244" Foreground="#A6E3A1" IsIndeterminate="True" Visibility="Collapsed"/>
        </StackPanel>

        <!-- 7. Action Footer -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="* 為必填欄位。在背景自動匯出的 PDF / DWG 會隨圖檔一同送審並自動蓋上防偽章。" 
                       Foreground="#7F849C" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,15,0"/>
            <Button x:Name="BtnSubmit" Grid.Column="1" Content="送出送審單" Style="{StaticResource PrimaryButton}" Click="BtnSubmit_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
